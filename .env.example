API_PORT=8000
FRONTEND_PORT=5173
# development or production. In production, placeholder secrets below abort startup.
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=Data Aggregator
# Placeholder on purpose: generate a real value with `python scripts/generate_secrets.py`.
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/aggregator
DEFAULT_ADMIN_USERNAME=admin
# Placeholder on purpose: generate a real value with `python scripts/generate_secrets.py`.
DEFAULT_ADMIN_PASSWORD=admin123
WORKER_POLL_INTERVAL=3
WORKER_DEFAULT_MAX_ATTEMPTS=5
WORKER_TELEGRAM_LIVE_MAX_ATTEMPTS=5
WORKER_TELEGRAM_BACKFILL_MAX_ATTEMPTS=7
WORKER_DARKNET_MAX_ATTEMPTS=5
WORKER_WEB_MAX_ATTEMPTS=4
WORKER_TELEGRAM_LIVE_LOCK_MINUTES=8
WORKER_TELEGRAM_BACKFILL_LOCK_MINUTES=20
WORKER_DARKNET_LOCK_MINUTES=20
WORKER_WEB_LOCK_MINUTES=15
WORKER_TELEGRAM_LIVE_BACKOFF_MAX_SECONDS=120
WORKER_TELEGRAM_BACKFILL_BACKOFF_MAX_SECONDS=300
WORKER_DARKNET_BACKOFF_MAX_SECONDS=900
WORKER_WEB_BACKOFF_MAX_SECONDS=600
TELEGRAM_PARALLEL_JOBS_PER_ACCOUNT=3
TELEGRAM_BACKFILL_PARALLEL_JOBS_PER_ACCOUNT=1
DARKNET_PARALLEL_JOBS_PER_ACCOUNT=1
WORKER_DARKNET_CONCURRENCY=16
WEB_PARALLEL_JOBS_PER_ACCOUNT=2
TELEGRAM_FETCH_LIMIT=200
TELEGRAM_FETCH_TIMEOUT_SECONDS=900
TELEGRAM_LISTENER_REFRESH_SECONDS=30
DARKNET_HTTP_TIMEOUT_SECONDS=90
NATS_ENABLED=true
NATS_SERVERS=nats://nats:4222
NATS_STREAM_NAME=AGG_JOBS
NATS_SUBJECT_PREFIX=jobs
NATS_PUBLISH_TIMEOUT_SECONDS=2
NATS_FETCH_BATCH_SIZE=16
NATS_FETCH_TIMEOUT_SECONDS=2
NATS_CONSUMER_ACK_WAIT_SECONDS=120
NATS_CONSUMER_MAX_DELIVER=25
NATS_DISPATCH_BATCH_SIZE=500
NATS_DISPATCH_MIN_INTERVAL_SECONDS=10
TOR_PROXY=socks5://torproxy:9050
S3_ENABLED=true
S3_ENDPOINT_URL=http://minio:9000
# Placeholders on purpose: generate real values with `python scripts/generate_secrets.py`.
S3_ACCESS_KEY=minio
S3_SECRET_KEY=miniosecret
S3_BUCKET=raw-events
S3_REGION=us-east-1
S3_USE_SSL=false
MEDIA_MAX_BYTES=52428800
WA_STREAM=WA_EVENTS
WA_DURABLE=wa-listener

# ClickHouse (events store)
CLICKHOUSE_ENABLED=true
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=aggregator
